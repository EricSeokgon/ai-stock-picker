# ─── AI API ───────────────────────────────────────
ANTHROPIC_API_KEY=your_key_here

# ─── 데이터베이스 ──────────────────────────────────
# 로컬 개발: localhost / Docker: db (서비스명)
DATABASE_URL=postgresql+asyncpg://stock_picker:stock_picker@db:5432/stock_picker

# ─── Redis ────────────────────────────────────────
# 로컬 개발: localhost / Docker: redis (서비스명)
REDIS_URL=redis://redis:6379/0

# ─── 보안 ─────────────────────────────────────────
# 운영 환경에서는 반드시 충분히 긴 무작위 문자열로 교체
SECRET_KEY=change-me-in-production-use-a-long-random-string

# ─── CORS ─────────────────────────────────────────
# 쉼표 구분. Docker 스택: http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── 텔레그램 알림 (선택) ──────────────────────────
# 미설정 시 봇 비활성화 (서비스 정상 기동)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── 이메일 알림 (선택) ────────────────────────────
# 미설정 시 이메일 알림 비활성화
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ─── 실시간 가격 ───────────────────────────────────
# false=실시간 API 사용, true=목업 데이터 (개발/테스트 시)
REALTIME_PRICE_MOCK=false
# 초 단위 폴링 간격 (기본 60)
REALTIME_POLL_INTERVAL=60

# ─── 스케줄러 ──────────────────────────────────────
# 멀티워커 환경에서는 한 워커만 true로 설정, 테스트 시 false
ENABLE_SCHEDULER=true

# ─── 로그 ─────────────────────────────────────────
LOG_LEVEL=INFO
